# scripts/setup.sh creates .env with random local secrets. Never commit .env.
POSTGRES_USER=forum
POSTGRES_DB=forum
POSTGRES_PASSWORD=generate_with_setup
POSTGRES_PORT=55432
POSTGRES_CONTAINER=forum-postgres
DATABASE_URL=postgres://forum:generate_with_setup@127.0.0.1:55432/forum?sslmode=disable
SESSION_SECRET=generate_at_least_32_random_characters
APP_ORIGIN=http://localhost:5173
API_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
